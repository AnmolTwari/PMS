<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Register</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="/css/register.css">
</head>
<body class="bg-blue-50 flex items-center justify-center min-h-screen">
    <div class="bg-white p-10 rounded-xl shadow-2xl w-full max-w-md fade-in">
        <h1 class="text-3xl font-extrabold text-blue-600 mb-8 text-center">Create Your Account</h1>

        <% if (error) { %>
            <p class="text-red-500 text-sm mb-6 text-center bg-red-50 p-3 rounded-lg animate-pulse"><%= error %></p>
        <% } %>

        <form action="/register" method="POST" class="space-y-5">
            <div>
                <input type="text" name="username" placeholder="Username" required 
                       class="w-full px-4 py-3 border border-blue-200 rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-400 input-focus bg-blue-50 text-gray-800 placeholder-gray-400" />
            </div>
            <div>
                <input type="email" name="email" placeholder="Email" required 
                       class="w-full px-4 py-3 border border-blue-200 rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-400 input-focus bg-blue-50 text-gray-800 placeholder-gray-400" />
            </div>
            <div>
                <input type="password" name="password" placeholder="Password" required 
                       class="w-full px-4 py-3 border border-blue-200 rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-400 input-focus bg-blue-50 text-gray-800 placeholder-gray-400" />
            </div>
            <div>
                <input type="text" name="mobile" placeholder="Mobile Number" required 
                       class="w-full px-4 py-3 border border-blue-200 rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-400 input-focus bg-blue-50 text-gray-800 placeholder-gray-400" />
            </div>
            <div>
                <input type="text" name="employeeId" placeholder="Employee ID" required 
                       class="w-full px-4 py-3

 border border-blue-200 rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-400 input-focus bg-blue-50 text-gray-800 placeholder-gray-400" />
            </div>
            <button type="submit" 
                    class="w-full bg-blue-400 text-white py-3 rounded-lg hover:bg-blue-500 button-hover font-semibold text-lg">
                Register
            </button>
        </form>

        <p class="mt-6 text-center text-gray-600">
            Already have an account? 
            <a href="/login" class="text-blue-500 hover:text-blue-600 hover:underline font-medium">Login</a>
        </p>
    </div>
</body>
</html>