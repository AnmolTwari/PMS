<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <!-- Bootstrap & Bootstrap Icons CSS -->
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.0/font/bootstrap-icons.css" rel="stylesheet">
  <link rel="stylesheet" href="/css/user-Panel.css" />
  <title>Executive Dashboard - Parksy</title>
</head>

<body id="top">

  <!-- Navbar -->
  <nav class="navbar navbar-expand-lg" style="background-color: #1e40af; height: 80px;">
    <div class="container-fluid h-100 d-flex align-items-center justify-content-between">
      <!-- Logo -->
      <a class="navbar-brand d-flex align-items-center" href="/home">
        <img src="/images/logo.png" alt="Logo" style="height: 110px;" class="me-3">
      </a>
      <!-- Centered welcome message -->
      <div class="position-absolute start-50 translate-middle-x text-white">
        <strong>Welcome, <%= username %>!</strong>
      </div>
      <!-- Toggler -->
      <button class="navbar-toggler bg-light" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav">
        <span class="navbar-toggler-icon"></span>
      </button>
      <!-- Nav Links -->
      <div class="collapse navbar-collapse justify-content-end" id="navbarNav">
        <ul class="navbar-nav">
          <li class="nav-item">
            <a class="nav-link text-white fw-semibold active px-3" href="#top">Home</a>
          </li>
          <li class="nav-item">
            <a class="nav-link text-white fw-semibold px-3" href="#about">About</a>
          </li>
          <li class="nav-item">
            <a class="nav-link text-white fw-semibold px-3" href="#services">Services</a>
          </li>
          <li class="nav-item">
            <a class="nav-link text-white fw-semibold px-3" href="#contact">Contact</a>
          </li>
        </ul>
      </div>

    </div>
  </nav>

  <!-- Alert system -->
  <div class="alert-system" id="alertSystem"></div>

  <div class="container-fluid my-4 px-4">
    <!-- Main Dashboard Grid -->
    <div class="dashboard-grid">
      <!-- Executive Profile Card -->
      <div class="executive-card">
        <div class="loading-overlay" id="profileLoader">
          <div class="spinner"></div>
        </div>
        <div class="card-header">
          <div class="card-icon">👤</div>
          <div class="card-title">Your Profile</div>
        </div>
        <div class="info-matrix">
          <div class="info-cell">
            <div class="info-label">Employee ID</div>
            <div class="info-value">
              <span>
                <%= employeeId %>
              </span>
              <span style="color: #4caf50;">●</span>
            </div>
          </div>
          <div class="info-cell">
            <div class="info-label">Corporate Email</div>
            <div class="info-value">
              <%= email %>
            </div>
          </div>
          <div class="info-cell">
            <div class="info-label">Direct Line</div>
            <div class="info-value">
              <%= mobile %>
            </div>
          </div>
          <div class="info-cell">
            <div class="info-label">Department</div>
            <div class="info-value">
              <%= department %>
            </div>
          </div>
        </div>
        <!-- Vehicle Info Section -->
        <div class="vehicle-status" id="vehicleStatus">
          <div class="vehicle-content">
            <div class="status-card">
              <div class="card-icon">🚗</div>
              <span class="card-label">Active Vehicle</span>
            </div>

            <div class="info-cell">
              <div class="info-label">Registered Vehicle</div>
              <div class="info-value">
                <span>
                  <%= vehicleNo %>
                </span>
                <span style="color: #4fc3f7;">🅿️</span>
              </div>
            </div>
          </div>
        </div>
        <!-- Reservation Slot Details -->
        <div id="reservationDetailsContainer" class="reservation-details">
          <% if (bookedSlot && bookedSlot.carNumber!==null ) { %>
            <div class="reservation-card">
              <h3>🚗 Reserved Parking Details</h3>
              <p><strong>Parking Area:</strong>
                <%= bookedSlot.areaName %>
              </p>
              <p><strong>Slot Number:</strong>
                <%= bookedSlot.slotNumber %>
              </p>
              <p><strong>Reservation Time:</strong>
                <%= bookedSlot.bookingTime ? bookedSlot.bookingTime.toLocaleString() : 'N/A' %>
              </p>
              <form id="releaseForm">
                <input type="hidden" name="vehicleNo" value="<%= vehicleNo %>" />
                <button type="submit" class="btn btn-danger" id="releaseSlotBtn">❌ Release Slot</button>
              </form>
            </div>
            <% } else { %>
              <div class="reservation-card">
                <p>No active parking reservation.</p>
              </div>
              <% } %>
        </div>
      </div>
      <!-- Smart Parking Control -->
      <div class="executive-card">
        <div class="loading-overlay" id="parkingLoader">
          <div class="spinner"></div>
        </div>
        <div class="card-header">
          <div class="card-icon">🅿️</div>
          <div class="card-title">Smart Parking Control</div>
        </div>
        <div class="form-container">
          <form id="parkingForm">
            <div class="form-group">
              <label class="form-label">Select Parking Area</label>
              <select id="parkingAreaSelect" class="form-input" required>
                <option value="" disabled selected>-- Select Parking Area --</option>
                <option value="Area 1">Parking Area 1</option>
                <option value="Area 2">Parking Area 2</option>
                <option value="Area 3">Parking Area 3</option>
                <option value="Area 4">Parking Area 4</option>
              </select>
            </div>
            <div class="form-group">
              <label class="form-label">Select Parking Slot</label>
              <select name="slotId" id="slotSelect" class="form-input" required>
                <option value="" disabled selected>-- Select a Slot --</option>
              </select>
            </div>
            <div class="form-group">
              <label class="form-label">Vehicle Registration</label>
              <input type="text" name="vehicleNo" class="form-input"
                placeholder="Enter vehicle registration (e.g., EXEC-2024-VIP)" required>
            </div>
            <div class="btn-group">
              <button type="submit" class="btn btn-primary">
                <span>🅿️</span> Reserve Parking
              </button>
              <button type="button" class="btn btn-secondary" id="checkStatusBtn">
                <span>📊</span> Check Status
              </button>
            </div>

          </form>
        </div>



      </div>
    </div>

    <!-- Executive Navigation -->
    <div class="executive-nav">
      <a href="#" class="nav-link"><span>⚙️</span> Settings</a>
      <a href="#" class="nav-link"><span>🚪</span> Logout</a>
    </div>
  </div>

  <!-- User Status Modal -->
  <div id="statusModal" class="modal">
    <div class="modal-content">
      <span class="close" id="closeModalBtn">&times;</span>
      <div id="modalBody">Loading status...</div>
    </div>
  </div>

  <!-- About Section -->
  <section id="about" class="py-5" style="background-color: #f8f9fa;">
    <div class="container">
      <div class="row justify-content-center text-center">
        <div class="col-lg-8">
          <!-- <h2 class="mb-4 text-primary">About ParkSy</h2> -->
          <p class="lead">
            <strong>ParkSy</strong> is a smart parking management system designed to modernize and simplify parking
            operations for residential complexes, corporate offices, malls, and public spaces.
          </p>
          <p>
            With real-time slot tracking, smooth user experience, and a powerful admin dashboard, ParkSy makes parking
            more efficient, secure, and stress-free for both operators and users.
          </p>
          <ul class="list-unstyled text-start my-4">
            <li><i class="bi bi-check-circle-fill text-primary me-2"></i> Real-time slot availability & booking</li>
            <li><i class="bi bi-check-circle-fill text-primary me-2"></i> User & Admin Dashboards with smart controls
            </li>
            <li><i class="bi bi-check-circle-fill text-primary me-2"></i> Secure login, password reset, and alerts</li>
            <li><i class="bi bi-check-circle-fill text-primary me-2"></i> Easy vehicle check-in/out and history tracking
            </li>
            <li><i class="bi bi-check-circle-fill text-primary me-2"></i> Built using Node.js, Express, EJS, and MongoDB
            </li>
          </ul>
          <p>
            Whether you're managing a single parking area or a multi-zone setup, ParkSy is designed to scale and adapt
            to your needs — with simplicity, speed, and reliability at its core.
          </p>
          <p class="mb-0">
            <strong>Choose ParkSy</strong> for smarter parking management — because every slot counts.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Services Section -->
  <section id="services" class="py-5 bg-light">
    <div class="container text-center">
      <!-- <h2 class="text-primary mb-4">Our Services</h2> -->
      <p class="lead mb-5">
        At <strong>ParkSy</strong>, we offer smart, scalable, and intuitive parking solutions designed to enhance
        convenience, control, and security.
      </p>
      <div class="row g-4">
        <!-- Service Card 1 -->
        <div class="col-md-4">
          <div class="p-4 border rounded shadow-sm h-100">
            <i class="bi bi-broadcast-pin fs-1 text-primary mb-3"></i>
            <h5 class="fw-bold">Real-Time Monitoring</h5>
            <p class="text-muted">
              Instantly view available and occupied slots with live updates for smooth vehicle flow and space
              optimization.
            </p>
          </div>
        </div>
        <!-- Service Card 2 -->
        <div class="col-md-4">
          <div class="p-4 border rounded shadow-sm h-100">
            <i class="bi bi-speedometer2 fs-1 text-primary mb-3"></i>
            <h5 class="fw-bold">Interactive Dashboards</h5>
            <p class="text-muted">
              Get visual insights into parking usage, reservations, and system performance through user-friendly admin
              dashboards.
            </p>
          </div>
        </div>
        <!-- Service Card 3 -->
        <div class="col-md-4">
          <div class="p-4 border rounded shadow-sm h-100">
            <i class="bi bi-gear-wide-connected fs-1 text-primary mb-3"></i>
            <h5 class="fw-bold">Automated Slot Booking</h5>
            <p class="text-muted">
              Allow users to reserve slots in advance, receive confirmations, and access parking smoothly through smart
              automation.
            </p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Contact Section -->
  <section id="contact" class="py-5">
    <div class="container">
      <div class="row justify-content-center text-center mb-4">
        <div class="col-lg-8">
          <!-- <h2 class="text-primary mb-3">Contact Us</h2> -->
          <p class="lead">
            Have questions, suggestions, or feedback? We'd love to hear from you. Reach out to us at
            <strong>support@parksy.com</strong> or fill out the form below.
          </p>
        </div>
      </div>
      <div class="row justify-content-center">
        <div class="col-md-8">
          <form action="/contact" method="POST">
            <div class="row mb-3">
              <div class="col-md-6">
                <input type="text" class="form-control" name="name" placeholder="Your Name" required>
              </div>
              <div class="col-md-6">
                <input type="email" class="form-control" name="email" placeholder="Your Email" required>
              </div>
            </div>
            <div class="mb-3">
              <input type="text" class="form-control" name="subject" placeholder="Subject" required>
            </div>
            <div class="mb-3">
              <textarea class="form-control" name="message" rows="5" placeholder="Your Message" required></textarea>
            </div>
            <div class="text-center">
              <button type="submit" class="btn btn-primary px-4">Send Message</button>
            </div>
          </form>
        </div>
      </div>
    </div>
  </section>

  <!-- Footer -->
  <footer class="bg-primary text-white text-center text-lg-start">
    <div class="container p-4">
      <div class="row">
        <div class="col-lg-6 col-md-12 mb-4 mb-md-0">
          <h5 class="text-uppercase">About Parksy</h5>
          <p>
            Parksy is a smart solution for efficient parking management. Whether you're managing a facility or looking
            for a seamless parking experience, Parksy makes reserving and monitoring parking spots easy and efficient.
          </p>
          <p>
            Join thousands of users transforming parking operations with our easy-to-use platform designed for
            businesses and individuals alike.
          </p>
        </div>
        <div class="col-lg-3 col-md-6 mb-4 mb-md-0">
          <h5 class="text-uppercase">Social Links</h5>
          <ul class="list-unstyled mb-0">
            <li><a href="https://www.instagram.com/cgcuniversitymohali/">Instagram</a></li>
            <li><a href="https://www.facebook.com/ChandigarhGroupOfCollegesLandran/">Facebook</a>
            </li>
            <li><a href="https://x.com/cgcuniversity">X</a></li>
            <li><a href="https://www.youtube.com/@cgcjhanjeri">Youtube</a></li>
          </ul>
        </div>

      </div>
    </div>
    <div class="text-center p-3" style="background-color: rgba(0, 0, 0, 0.2);">
      © 2020 Copyright:
      <a class="text-white" href="/views/thank-you.ejs">Parksy.com</a>
    </div>
  </footer>

  <!-- Scripts -->
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
  <script src="/js/user-Panel.js" defer></script>
</body>

</html>