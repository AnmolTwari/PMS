<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Document</title>
</head>
<body>
    <h2>📊 Parking Slot Status</h2>
<% for (let area in statusData) { %>
  <div style="margin-bottom: 15px;">
    <h3><%= area %></h3>
    <p>🟢 Available: <%= statusData[area].available %></p>
    <p>🔴 Occupied: <%= statusData[area].occupied %></p>
    <p>🅿️ Total: <%= statusData[area].total %></p>
  </div>
<% } %>
</body>
</html>
