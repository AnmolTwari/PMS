<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <title>Reset Password - Professional Portal</title>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet"/>
  <style>
    body {
      font-family: 'Inter', sans-serif;
      background-color: #f4f6f8;
      margin: 0;
      padding: 0;
    }
    .forgot-container {
      max-width: 400px;
      margin: 60px auto;
      padding: 2rem;
      background-color: #fff;
      border-radius: 12px;
      box-shadow: 0 10px 25px rgba(0, 0, 0, 0.1);
    }
    .forgot-header {
      text-align: center;
      margin-bottom: 2rem;
    }
    .forgot-icon {
      margin-bottom: 1rem;
    }
    .forgot-icon svg {
      width: 40px;
      height: 40px;
      color: #4f46e5;
    }
    .forgot-header h2 {
      margin: 0;
      font-size: 1.5rem;
      color: #333;
    }
    .forgot-header p {
      color: #666;
      font-size: 0.95rem;
    }
    .form-group {
      margin-bottom: 1.5rem;
    }
    .form-label {
      display: block;
      margin-bottom: 0.5rem;
      color: #333;
    }
    .form-input {
      width: 100%;
      padding: 0.75rem;
      border: 1px solid #ccc;
      border-radius: 6px;
      font-size: 1rem;
    }
    .reset-button {
      width: 100%;
      padding: 0.75rem;
      background-color: #4f46e5;
      color: white;
      font-size: 1rem;
      border: none;
      border-radius: 6px;
      cursor: pointer;
      transition: background-color 0.3s ease;
    }
    .reset-button:hover {
      background-color: #4338ca;
    }
    .back-link {
      display: inline-flex;
      align-items: center;
      margin-top: 1rem;
      font-size: 0.95rem;
      color: #4f46e5;
      text-decoration: none;
    }
    .back-link svg {
      width: 16px;
      height: 16px;
      margin-right: 5px;
    }
    .divider {
      text-align: center;
      margin: 2rem 0 1rem;
      color: #999;
      font-size: 0.85rem;
    }
    .footer-links {
      text-align: center;
      font-size: 0.85rem;
      color: #888;
    }
    .footer-links a {
      color: #4f46e5;
      text-decoration: none;
    }
    .alert {
      padding: 0.75rem 1rem;
      border-radius: 6px;
      font-size: 0.95rem;
      margin-bottom: 1.5rem;
      text-align: center;
    }
    .alert-success {
      background-color: #dcfce7;
      color: #15803d;
    }
    .alert-error {
      background-color: #fee2e2;
      color: #b91c1c;
    }
    .alert-info {
      background-color: #e0f2fe;
      color: #0369a1;
    }
  </style>
</head>
<body>
  <div class="forgot-container">
    <div class="forgot-header">
      <div class="forgot-icon">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <path d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/>
        </svg>
      </div>
      <h2>Reset Password</h2>
      <p>Enter your email address and we'll send you a link to reset your password.</p>
    </div>

    <div class="forgot-body">
      <% if (successMessage) { %>
  <div class="alert alert-success" id="alert-box"><%= successMessage %></div>
<% } else if (errorMessage) { %>
  <div class="alert alert-error" id="alert-box"><%= errorMessage %></div>
<% } %>


      <form action="/forgot-password" method="POST">
        <div class="form-group">
          <label class="form-label" for="email">Email Address</label>
          <input type="email" class="form-input" id="email" name="email" placeholder="you@example.com" required />
        </div>
        <button type="submit" class="reset-button">Send Reset Link</button>
      </form>

      <a href="/login" class="back-link">
        <svg fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
          <path d="M15 19l-7-7 7-7" />
        </svg>
        Back to Login
      </a>

      <div class="divider"><span>Need help?</span></div>

      <div class="footer-links">
        <p>Contact our <a href="#">support team</a> for assistance.</p>
        <p>&copy; 2025 Professional Portal</p>
      </div>
    </div>
  </div>

  <!-- Script to auto-hide alert after 4 seconds -->
  <script>
    const alertBox = document.getElementById('alert-box');
    if (alertBox) {
      setTimeout(() => {
        alertBox.style.display = 'none';
      }, 4000);
    }
  </script>
</body>
</html>
